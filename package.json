{
  "name": "calculearn",
  "version": "0.1.0",
  "description": "Offline-first adaptive calculus tutoring agent powered by Gemma 4 on-device",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "smoke": "tsx src/main.ts",
    "dev": "tsx src/main.ts",
    "seed": "tsx src/db/seedDatabase.ts",
    "bundle": "tsx scripts/bundle.ts",
    "hash": "tsx scripts/computeModelHashes.ts",
    "install-model": "tsx scripts/installModel.ts",
    "serve:ui": "npx --yes serve dist/ui"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.9.0",
    "lru-cache": "^10.2.0",
    "mathjs": "^12.4.1",
    "node-llama-cpp": "^3.1.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.11.20",
    "@types/uuid": "^9.0.8",
    "fast-check": "^3.17.2",
    "katex": "^0.16.45",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.4.0"
  }
}
