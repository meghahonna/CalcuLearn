{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Concept",
  "type": "object",
  "required": [
    "concept_id", "name", "track", "one_liner", "prerequisites",
    "explanations", "examples", "misconceptions", "checks", "deep_dives", "applications"
  ],
  "additionalProperties": false,
  "properties": {
    "concept_id": { "type": "string", "minLength": 2 },
    "name": { "type": "string", "minLength": 2 },
    "track": { "enum": ["AB", "BC", "BOTH"] },
    "one_liner": { "type": "string", "minLength": 10, "maxLength": 250 },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 }
    },
    "explanations": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["tier", "framing_index", "body_md"],
        "additionalProperties": false,
        "properties": {
          "tier": { "enum": ["novice", "on_pace", "advanced"] },
          "framing_index": { "type": "integer", "minimum": 0 },
          "body_md": { "type": "string", "minLength": 50 },
          "intuition_md": { "type": "string" }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["tier", "problem_md", "steps"],
        "additionalProperties": false,
        "properties": {
          "tier": { "enum": ["novice", "on_pace", "advanced"] },
          "problem_md": { "type": "string", "minLength": 5 },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["step_md", "why_md"],
              "additionalProperties": false,
              "properties": {
                "step_md": { "type": "string", "minLength": 1 },
                "why_md": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "misconceptions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["short_name", "description_md", "why_wrong_md", "socratic_response_md"],
        "additionalProperties": false,
        "properties": {
          "short_name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description_md": { "type": "string", "minLength": 10 },
          "why_wrong_md": { "type": "string", "minLength": 10 },
          "socratic_response_md": { "type": "string", "minLength": 10 }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["tier", "question_md", "expected_answer_md"],
        "additionalProperties": false,
        "properties": {
          "tier": { "enum": ["novice", "on_pace", "advanced"] },
          "question_md": { "type": "string", "minLength": 5 },
          "expected_answer_md": { "type": "string", "minLength": 1 },
          "expected_pattern": { "type": "string" },
          "misconception_short_name_if_wrong": { "type": "string" }
        }
      }
    },
    "deep_dives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "body_md"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 5 },
          "body_md": { "type": "string", "minLength": 50 }
        }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["problem_md", "solution_outline_md"],
        "additionalProperties": false,
        "properties": {
          "context": { "enum": ["physics", "economics", "biology", "engineering", "everyday"] },
          "problem_md": { "type": "string", "minLength": 10 },
          "solution_outline_md": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
